{
  "name": "@email-automation-engine/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src",
    "format:check": "prettier --check package.json tsconfig.json vitest.config.ts vitest.integration.config.ts src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1062.0",
    "@aws-sdk/client-sqs": "^3.1059.0",
    "@email-automation-engine/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.0",
    "pg": "^8.21.0",
    "typeorm": "^0.3.30",
    "uuid": "^14.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
